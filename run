#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

show_help() {
    cat << EOF
Usage: ./run <command>

Commands:
  build           Compile the TypeScript project to dist/
  build:watch     Build with watch mode
  test            Run tests
  test:watch      Run tests in watch mode
  lint            Run ESLint
  lint:fix        Run ESLint with auto-fix
  format          Format code with Prettier
  format:check    Check formatting
  typecheck       Run TypeScript type checking
  ci              Run all CI checks (typecheck, lint, format:check, test)
  deploy-halos    Build and install the plugin onto a HaLOS device's Signal K
  bumpversion     Bump version (patch|minor|major)
  help            Show this help message
EOF
}

# Build locally and install onto a HaLOS device's Signal K as a durable file: dependency.
# Companion to @halos-org/skip's own deploy-halos: that ships the webapp, this ships the
# Freeboard-SK panel plugin. A server-plugin update always needs a Signal K restart to
# reload the in-process code (unlike a webapp, whose files express.static serves fresh).
deploy_halos() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo "Usage: ./run deploy-halos <target_host|local>"
        echo ""
        echo "Builds dist/ locally, then installs it into the target device's Signal K"
        echo "data volume as a declared file: dependency (so a later 'npm install' won't"
        echo "prune it) and restarts Signal K. Pass 'local' when running on the device"
        echo "itself; a hostname deploys over ssh (needs ssh access + passwordless sudo)."
        echo ""
        echo "Examples:"
        echo "  ./run deploy-halos local          # on the device itself"
        echo "  ./run deploy-halos halpi.hurma    # from a dev machine, over ssh"
        return 1
    fi

    local pkg slug data sysdir dest
    pkg=$(node -p "require('./package.json').name")   # @halos-org/skip-freeboard-panel
    slug="${pkg##*/}"                                  # skip-freeboard-panel
    data="/var/lib/container-apps/marine-signalk-server-container/data/data"
    sysdir="${data}/system-plugins/${slug}"

    local -a runner
    if [[ "$target" == local || "$target" == localhost ]]; then
        dest=""; runner=(bash -s --)
    else
        dest="${target}:"; runner=(ssh "$target" bash -s --)
    fi

    echo "==> Building plugin (locally)..."
    npm run build

    echo "==> Preparing ${dest}${sysdir} (backing up any existing install)..."
    "${runner[@]}" "$sysdir" <<'PREP'
set -o errexit -o nounset -o pipefail
sysdir="$1"
mkdir -p "$sysdir"
if [ -n "$(ls -A "$sysdir" 2>/dev/null)" ]; then
  tar -czf "$HOME/$(basename "$sysdir")-predeploy-$(date +%F-%H%M%S).tar.gz" \
    -C "$(dirname "$sysdir")" "$(basename "$sysdir")"
fi
PREP

    # Ship the plugin's runtime payload: the compiled output (dist/) and its manifest.
    echo "==> Syncing build to ${target}..."
    rsync -rlpt --delete dist/ "${dest}${sysdir}/dist/"
    rsync -lpt package.json "${dest}${sysdir}/package.json"

    echo "==> Linking, registering the dependency, and restarting Signal K..."
    "${runner[@]}" "$pkg" "$slug" "$data" <<'REMOTE'
set -o errexit -o nounset -o pipefail
pkg="$1"; slug="$2"; data="$3"

# Link into node_modules exactly as npm does for a file: dependency (scope-aware).
# Remove any existing entry first so `ln` replaces it rather than nesting inside it.
scope="${pkg%/*}"
link="${data}/node_modules/${pkg}"
rm -rf "$link"
if [ "$scope" != "$pkg" ]; then
  mkdir -p "${data}/node_modules/${scope}"
  ln -s "../../system-plugins/${slug}" "$link"
else
  ln -s "../system-plugins/${slug}" "$link"
fi

# Declare it in package.json so npm treats it as owned and never prunes it.
python3 - "$data" "$pkg" "$slug" <<'PY'
import json, sys
data, pkg, slug = sys.argv[1:4]
path = data + "/package.json"
cfg = json.load(open(path))
deps = cfg.setdefault("dependencies", {})
want = "file:system-plugins/" + slug
if deps.get(pkg) != want:
    deps[pkg] = want
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    print("  registered", pkg, "->", want)
else:
    print(" ", pkg, "already registered")
PY

# A server plugin runs in the Signal K process and is loaded at boot, so an update
# needs a restart to reload the code (there is no express.static equivalent here).
sudo docker restart signalk-server

# Verify through Traefik (HTTPS, device CA). Never the container's :3000 port.
ca=/usr/local/share/ca-certificates/halos-ca.crt
domain=$(hostname -d 2>/dev/null || true)
[ -z "$domain" ] && domain=$(awk '/^search/{print $2; exit}' /etc/resolv.conf 2>/dev/null)
base="https://$(hostname)${domain:+.$domain}:4430"
echo "  waiting for Signal K at ${base} ..."
for _ in $(seq 1 25); do
  if curl -sf --max-time 10 --cacert "$ca" "${base}/skServer/plugins" >/dev/null 2>&1; then break; fi
  sleep 3
done
if curl -s --max-time 10 --cacert "$ca" "${base}/skServer/plugins" 2>/dev/null | grep -qF "\"$pkg\""; then
  echo "  OK: ${pkg} is installed (listed in /skServer/plugins)"
else
  echo "  WARN: ${pkg} not listed at ${base}/skServer/plugins — check it is enabled in the SK admin UI (or that /skServer/plugins is reachable)"
fi
REMOTE

    echo ""
    echo "Deployed ${pkg} to ${target}; the Freeboard-SK panel registers once Signal K restarts."
    echo "It needs the @halos-org/skip webapp installed too (its panel iframe loads /@halos-org/skip/)."
}

case "${1:-help}" in
    build)        npm run build ;;
    build:watch)  npm run build:watch ;;
    test)         npm run test ;;
    test:watch)   npm run test:watch ;;
    lint)         npm run lint ;;
    lint:fix)     npm run lint:fix ;;
    format)       npm run format ;;
    format:check) npm run format:check ;;
    typecheck)    npm run typecheck ;;
    ci)           npm run ci ;;
    deploy-halos)
        shift
        deploy_halos "${1:-}"
        ;;
    bumpversion)
        shift
        bumpversion "${1:?Usage: ./run bumpversion <patch|minor|major>}"
        ;;
    help|--help|-h) show_help ;;
    *)
        echo "Unknown command: $1" >&2
        show_help
        exit 1
        ;;
esac
